# Server
PORT=5000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/smart-home

# JWT
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars

# ESP32 Device Authentication
# ESP32 gửi key này trong header: X-Device-Key: <value>
DEVICE_SECRET_KEY=your_esp32_device_secret_key_here

# Frontend Origin (CORS + Socket.io)
CLIENT_URL=http://localhost:3000
